# Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Local Postgres container (infra/postgres/compose.yml)
#
# These configure the *container*. Nothing in the pipeline reads them — they are
# a leftover of the standalone lineage, kept because compose interpolates them.
# ---------------------------------------------------------------------------
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=changeme
PGVECTOR_PORT=5432

# ---------------------------------------------------------------------------
# Database, as read by BOTH the mirrored online service
# (services/object_search_online/app.py::_build_dsn) and the bricks
# (toolbox/bricks/db.py). Same variable names on purpose: one source of truth, so
# the two can never end up pointing at different databases.
#
# ENVIRONMENT_NAME=onprem selects the env-var branch. Any other value sends the
# mirrored service to AWS Secrets Manager via WEMAP_VPS_SECRET_ID — not what you
# want locally.
# ---------------------------------------------------------------------------
ENVIRONMENT_NAME=onprem
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=object_search_db
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme

# Only for the AWS branch; leave unset locally.
# WEMAP_VPS_SECRET_ID=

# ---------------------------------------------------------------------------
# annotation_service (third_party/object_search/annotation_service)
#
# Owns the annotation ground truth. It resolves per-map databases at
# <ANNOTATION_DATA_DIR>/<slug>/object-search-annotations.db and the benchmark
# export at <ANNOTATION_DATA_DIR>/<slug>/benchmark/annotations.geojson — so
# pointing it at your maps directory makes <slug> the toolbox map id, which is
# what the benchmark runner already assumes.
# ---------------------------------------------------------------------------
ANNOTATION_DATA_DIR=/path/to/vps-data/maps
ANNOTATION_CORS_ORIGINS=http://localhost:45700

# ---------------------------------------------------------------------------
# Dev-only: where map directories live (georef.db, images_360/, depths/).
# ---------------------------------------------------------------------------
VPS_DATA_DIR=/path/to/vps-data
